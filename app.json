{
  "expo": {
    "name": "SaiyanTrainer",
    "slug": "SaiyanTrainer",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/vegeta_icon.png",
    "scheme": "saiyantrainer",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#fc7138"
      },
      "package": "com.marinko369.SaiyanTrainer",
      "versionCode": 3
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Scouter treba kameru za skeniranje barkoda.",
          "recordAudioAndroid": false
        }
      ],
      "./plugins/withReleaseSigning"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4e6ad2f2-a33e-469a-bf41-82098c4e2eff"
      }
    },
    "owner": "marinko369"
  }
}
